# ===========================================================================
# SanskyStream — root .gitignore
# ===========================================================================

# ---------------------------------------------------------------------------
# Windows build artifacts (CMake / MSBuild / MSVC)
# ---------------------------------------------------------------------------
windows/build/
*.obj
*.pdb
*.exp
*.ilk
*.tlog

# ---------------------------------------------------------------------------
# Android build artifacts and Gradle caches
# ---------------------------------------------------------------------------
android/build/
android/.gradle/
android/app/build/
android/local.properties

# ---------------------------------------------------------------------------
# OBS SDK — acquired via setup-obs-sdk.ps1, never committed
# ---------------------------------------------------------------------------
windows/obs-sdk/libobs/
windows/obs-sdk/bin/
windows/obs-sdk/obs.lib
windows/obs-sdk/obs.exp

# OBS Plugin build output
windows/obs-plugin/build/

# ---------------------------------------------------------------------------
# Release directory — binaries excluded (generated by build), docs tracked
# ---------------------------------------------------------------------------
# Portable Windows binaries: generated from build, not stored in source control.
# To recreate: cmake --build windows/build --config Release --target SanskyStream_Windows
#              then copy EXE + VC++ runtime DLLs into release/Windows/Portable/
release/Windows/Portable/

# Android APK is committed as a release artifact (intentional).
# !release/Android/ — tracked (already not in any ignore pattern)

# ---------------------------------------------------------------------------
# IDE / editor artifacts
# ---------------------------------------------------------------------------
.idea/
*.iml
.vs/
*.user
*.suo
*.sdf
*.opensdf
.DS_Store
Thumbs.db